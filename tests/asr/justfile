set shell := ["bash", "-uc"]

# The install target — a throwaway "project" directory next to this
# justfile. Both providers install into here. Gitignored.
project := "project"

# Provider source directories (sibling dirs in tests/asr/).
provider1_src := "provider1"
provider2_src := "provider2"

# Provider names recorded in marker blocks and manifests.
provider1 := "provider1"
provider2 := "provider2"

# Default recipe: list available recipes.
default:
    @just --list

# Wipe and recreate the install target.
clean-target:
    rm -rf {{project}}
    mkdir -p {{project}}

# Install provider1 into the target (all three tools).
install-first: clean-target
    @echo "=== Installing '{{provider1}}' from {{provider1_src}}/ ==="
    clasr install \
        --source {{provider1_src}} \
        --provider {{provider1}} \
        --target {{project}} \
        --claude --codex --copilot

# Install provider2 on top of provider1, into the same target.
install-second:
    @echo
    @echo "=== Installing '{{provider2}}' from {{provider2_src}}/ ==="
    @echo "(same target dir; both providers must coexist)"
    clasr install \
        --source {{provider2_src}} \
        --provider {{provider2}} \
        --target {{project}} \
        --claude --codex

# Show every file and symlink under the target.
tree:
    @echo "=== Files under {{project}}/ ==="
    @find {{project}} \( -type f -o -type l \) | sort

# Print AGENTS.md so you can see BOTH marker blocks coexisting.
show-agents:
    @echo "=== {{project}}/AGENTS.md (should contain both providers' blocks) ==="
    @cat {{project}}/AGENTS.md

# Print CLAUDE.md so you can see BOTH marker blocks coexisting.
show-claude-md:
    @echo "=== {{project}}/CLAUDE.md (should contain both providers' blocks) ==="
    @cat {{project}}/CLAUDE.md

# Print the merged settings.json so you can see keys from both providers.
show-merged-settings:
    @echo "=== {{project}}/.claude/settings.json (merged) ==="
    @cat {{project}}/.claude/settings.json | python3 -m json.tool

# List the per-provider manifests under each tool's manifest dir.
show-manifests:
    @echo "=== Claude manifests (one per provider) ==="
    @ls -1 {{project}}/.claude/.clasr-manifest/
    @echo
    @echo "--- {{provider1}}.json ---"
    @cat {{project}}/.claude/.clasr-manifest/{{provider1}}.json | python3 -m json.tool
    @echo
    @echo "--- {{provider2}}.json ---"
    @cat {{project}}/.claude/.clasr-manifest/{{provider2}}.json | python3 -m json.tool

# Uninstall the SECOND provider only — first provider's files must remain.
uninstall-second:
    @echo "=== Uninstalling only '{{provider2}}' ==="
    clasr uninstall --provider {{provider2}} --target {{project}} --claude --codex

# Uninstall everything.
uninstall-all:
    -clasr uninstall --provider {{provider1}} --target {{project}} --claude --codex --copilot
    -clasr uninstall --provider {{provider2}} --target {{project}} --claude --codex

# Full multi-provider demo: install both, inspect, selective uninstall, cleanup.
demo: install-first install-second tree show-agents show-claude-md show-merged-settings show-manifests
    @echo
    @echo "============================================================"
    @echo "=== Selective uninstall — remove '{{provider2}}' only ==="
    @echo "============================================================"
    @just uninstall-second
    @echo
    @echo "=== After selective uninstall: '{{provider1}}' should still be intact ==="
    @echo
    @echo "--- AGENTS.md (only '{{provider1}}' block remains) ---"
    @cat {{project}}/AGENTS.md
    @echo
    @echo "--- .claude/settings.json (only '{{provider1}}' keys remain) ---"
    @cat {{project}}/.claude/settings.json | python3 -m json.tool
    @echo
    @echo "============================================================"
    @echo "=== Cleaning up the rest ==="
    @echo "============================================================"
    @just uninstall-all
    @echo
    @echo "=== Target should be empty after final uninstall ==="
    @find {{project}} \( -type f -o -type l \) | sort
    @rm -rf {{project}}

# Single-provider demo (install provider1, inspect, uninstall, confirm clean).
demo-single: install-first tree show-agents
    @echo
    @echo "=== Uninstalling '{{provider1}}' ==="
    @clasr uninstall --provider {{provider1}} --target {{project}} --claude --codex --copilot
    @echo
    @echo "=== Target should be empty ==="
    @find {{project}} \( -type f -o -type l \) | sort
    @rm -rf {{project}}

# Print the bundled clasr instructions.
instructions:
    clasr --instructions
